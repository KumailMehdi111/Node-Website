generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User & Auth
// ==========================================

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("CONTENT_MANAGER")
  status        String         @default("ACTIVE")
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==========================================
// CMS Core
// ==========================================

model Announcement {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  category        String?
  content         String
  featuredImage   String?
  publicationDate DateTime?
  status          String    @default("DRAFT")
  author          String?
  featuredFlag    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  date        DateTime
  startTime   String?
  endTime     String?
  location    String?
  image       String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([date])
}

model GalleryCategory {
  id            String         @id @default(uuid())
  name          String         @unique
  slug          String         @unique
  galleryImages GalleryImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GalleryImage {
  id           String          @id @default(uuid())
  caption      String?
  fileUrl      String
  categoryId   String
  category     GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status       String          @default("DRAFT")
  displayOrder Int?            @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([displayOrder])
}

model Download {
  id        String   @id @default(uuid())
  title     String
  category  String?
  class     String?
  year      String?
  fileUrl   String
  fileType  String
  fileSize  Int
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("Unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// Academics & Staff
// ==========================================

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  staff     Staff[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  photo         String?
  designation   String
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subject       String?
  qualification String?
  experience    String?
  bio           String?
  displayOrder  Int        @default(0)
  status        String     @default("DRAFT")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([displayOrder])
}

model Class {
  id            String         @id @default(uuid())
  className     String
  grade         Int
  description   String?
  activeStatus  Boolean        @default(true)
  displayOrder  Int            @default(0)
  totalSeats    Int            @default(0)
  occupiedSeats Int            @default(0)
  subjects      Subject[]
  books         Book[]
  timetables    Timetable[]
  syllabi       Syllabus[]
  examinations  ExamSchedule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Book {
  id        String   @id @default(uuid())
  bookTitle String
  author    String?
  publisher String?
  edition   String?
  fileUrl   String?
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Timetable {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  day       String
  period    Int
  subject   String
  teacher   String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Syllabus {
  id           String   @id @default(uuid())
  title        String
  description  String?
  fileUrl      String?
  academicYear String
  status       String   @default("DRAFT")
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([classId])
}

model AcademicCalendar {
  id           String   @id @default(uuid())
  title        String
  description  String?
  date         DateTime
  type         String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Examinations
// ==========================================

model ExamSchedule {
  id           String   @id @default(uuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      String
  examType     String
  date         DateTime
  day          String
  startTime    String
  endTime      String
  room         String?
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([classId])
}

model ExamGuideline {
  id           String   @id @default(uuid())
  title        String
  content      String
  displayOrder Int      @default(0)
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Sports & Activities
// ==========================================

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  image       String?
  date        DateTime?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Sport {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  category    String              @default("Outdoor")
  coach       String?
  image       String?
  status      String              @default("ACTIVE")
  events      SportEvent[]
  results     CompetitionResult[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([category])
}

model SportEvent {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompetitionResult {
  id          String   @id @default(uuid())
  competition String
  position    String
  participant String
  year        String
  achievement String?
  image       String?
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Admissions & Fee Structure
// ==========================================

model AdmissionNotice {
  id        String   @id @default(uuid())
  title     String
  content   String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionInquiry {
  id          String   @id @default(uuid())
  parentName  String
  email       String
  phone       String?
  studentName String
  grade       String
  message     String?
  status      String   @default("NEW")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model FeeStructure {
  id            String   @id @default(uuid())
  className     String
  admissionFee  Float
  monthlyFee    Float
  annualFee     Float
  otherCharges  Float?
  effectiveYear String
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// Settings & System
// ==========================================

model SchoolInformation {
  id           String  @id @default(uuid())
  name         String?
  address      String?
  phone        String?
  email        String?
  timings      String?
  aboutText    String?
  vision       String?
  mission      String?
  principalMsg String?
  principalName    String?
  principalTitle   String?
  principalPhoto   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String
  url          String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebsiteSetting {
  id             String   @id @default(uuid())
  schoolLogoUrl  String?
  faviconUrl     String?
  schoolName     String?
  primaryContact String?
  email          String?
  address        String?
  whatsappNumber String?
  googleMapsUrl  String?
  seoTitle       String?
  seoDescription String?
  footerText     String?
  statsStudents  String?  @default("1850+")
  statsTeachers  String?  @default("140+")
  statsPassRate  String?  @default("99.4%")
  statsCampus    String?  @default("45 Acres")
  statsClubs     String?  @default("32")
  heroImageUrl       String?
  heroCampusHighlight String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: SetDefault)
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}
